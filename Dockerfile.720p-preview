# Isolated 720p validation image. Production endpoint/image is never changed here.
# Derive from the verified ErosMax production image to avoid re-downloading models.
FROM --platform=linux/amd64 ghcr.io/towtsubac-dev/comfyui-runpod-serverless-erosmax@sha256:913e9e05292fa24d1bd4f0a67bf70155b7182244b5e5634dffb32291506b9b40
WORKDIR /workspace
COPY --link handler.py /workspace/handler.py
COPY --link eros_ref2va.py /workspace/eros_ref2va.py
COPY --link video_720p.py /workspace/video_720p.py
COPY --link tests/test_video_720p.py /workspace/tests/test_video_720p.py
RUN python -m py_compile /workspace/handler.py /workspace/eros_ref2va.py /workspace/video_720p.py \
    && python -m unittest discover -s /workspace/tests -p 'test_video_720p.py' -v
CMD ["python", "/workspace/handler.py"]
