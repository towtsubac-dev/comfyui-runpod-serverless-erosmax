# Isolated ErosMax extension alignment GPU Preview, NOT a Production image.
# Fast code-only rebase: reuse the exact known-good 24GB GPU base.
# Never change Dockerfile.extender-lora-fast, the release branch, or GHCR tags.
FROM --platform=linux/amd64 ghcr.io/towtsubac-dev/comfyui-runpod-serverless-erosmax@sha256:9ba7121bd64b86f798b97deaec7b1d1aca4bcfe9e64cc361046d50ee790111ff
COPY --link handler.py h3_extender_poc.py registered_lora.py extender_r2_io.py eros_ref2va.py lora_url_policy.py /workspace/
COPY --link tests/test_lora_url_policy.py tests/test_eros_standard_extend_alignment.py /workspace/tests/
RUN cd /workspace && python -m py_compile handler.py tests/test_eros_standard_extend_alignment.py \
 && python -m unittest discover -s tests -p 'test_lora_url_policy.py' -v \
 && python -m unittest discover -s tests -p 'test_eros_standard_extend_alignment.py' -v
WORKDIR /workspace
CMD ["python", "/workspace/handler.py"]
