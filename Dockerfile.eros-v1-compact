# ErosMax v1.0 Compact / RTX 4090 24GB isolated test build.
# Not used by Production; verify model SHA-256 before publishing.
# Build SageAttention against the exact PyTorch/CUDA runtime used by ErosMax.
# The build stage contains nvcc; the final image stays on the smaller runtime base.
FROM nvidia/cuda:13.0.0-devel-ubuntu24.04 AS cuda_toolkit
FROM pytorch/pytorch:2.12.0-cuda13.0-cudnn9-runtime AS sage_builder
COPY --from=cuda_toolkit /usr/local/cuda-13.0 /usr/local/cuda-13.0
ENV CUDA_HOME=/usr/local/cuda-13.0
ENV PATH=/usr/local/cuda-13.0/bin:$PATH
ENV TORCH_CUDA_ARCH_LIST="8.9;12.0"
ENV MAX_JOBS=2
# Avoid port-80 Ubuntu mirror failures; retry transient HTTPS failures.
RUN set -eu; \
    for source in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do \
        [ -f "$source" ] || continue; \
        sed -i \
            -e 's|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g' \
            -e 's|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' \
            "$source"; \
    done; \
    apt-get update -o Acquire::Retries=5 -o Acquire::https::Timeout=25 \
        -o APT::Update::Error-Mode=any; \
    apt-get install -y -o Acquire::Retries=5 --no-install-recommends \
        git gcc g++ ninja-build libgomp1; \
    rm -rf /var/lib/apt/lists/*
RUN pip install --break-system-packages --no-cache-dir packaging ninja setuptools wheel
RUN git clone --depth 1 --branch v2.2.0 https://github.com/thu-ml/SageAttention.git /tmp/SageAttention
RUN cd /tmp/SageAttention && pip wheel --no-build-isolation --no-deps -w /tmp/sage-wheels .

FROM pytorch/pytorch:2.12.0-cuda13.0-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/workspace/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# Both Ubuntu sources in this stage must use HTTPS too.
RUN set -eu; \
    for source in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do \
        [ -f "$source" ] || continue; \
        sed -i \
            -e 's|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g' \
            -e 's|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' \
            "$source"; \
    done; \
    apt-get update -o Acquire::Retries=5 -o Acquire::https::Timeout=25 \
        -o APT::Update::Error-Mode=any; \
    apt-get install -y -o Acquire::Retries=5 \
        git ffmpeg gcc g++ libgl1 libglib2.0-0; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN git clone --depth 1 --branch v0.46.0 \
    https://github.com/comfyanonymous/ComfyUI.git \
    /workspace/ComfyUI

# Keep the legacy backport for the existing extension path; add the separate production Extender.
RUN git clone --depth 1 https://github.com/kat3ri/ComfyUI-MiniMax-H3-Extend.git /workspace/ComfyUI/custom_nodes/ComfyUI-MiniMax-H3-Extend
RUN git clone --depth 1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git /workspace/ComfyUI/custom_nodes/ComfyUI-VideoHelperSuite

# Production Motion Context Extender v3.0.14 (distinct from kat3ri's backport).
RUN git init /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender && \
    git -C /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender fetch --depth 1 https://github.com/tritant/ComfyUI_MiniMax_H3_Extender.git b3e23bded3bcfb2398ec2470943b35330c7faaff && \
    git -C /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender checkout --detach FETCH_HEAD && \
    test "$(git -C /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender rev-parse HEAD)" = "b3e23bded3bcfb2398ec2470943b35330c7faaff"

WORKDIR /workspace/ComfyUI

RUN pip install --break-system-packages -r requirements.txt
RUN pip install --break-system-packages runpod requests huggingface_hub hf_transfer
RUN pip install --break-system-packages -r /workspace/ComfyUI/custom_nodes/ComfyUI-VideoHelperSuite/requirements.txt
RUN pip install --break-system-packages -r /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender/requirements.txt
RUN python -m compileall -q /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender && \
    grep -F '"MiniMaxH3Extender": MiniMaxH3Extender' /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender/extender.py && \
    grep -F '"MiniMaxH3MotionContextDiskFinalDecode": MiniMaxH3MotionContextDiskFinalDecode' /workspace/ComfyUI/custom_nodes/ComfyUI_MiniMax_H3_Extender/motion_context_disk.py

# Locally built SageAttention supports both RTX 4090 (SM89) and Blackwell (SM120).
COPY --from=sage_builder /tmp/sage-wheels/ /tmp/sage-wheels/
RUN pip install --break-system-packages --no-deps /tmp/sage-wheels/sageattention*.whl && rm -rf /tmp/sage-wheels
RUN python -c "import sageattention, torch; print('SageAttention import OK; torch=', torch.__version__)"

WORKDIR /workspace

COPY download_models_v1.py /workspace/download_models.py

# Download all required model weights during image build, not after a
# Serverless GPU worker starts. Existing handler checks these files and
# skips downloads when they are already present.
RUN python /workspace/download_models.py --verify && rm -rf /workspace/huggingface/hub

COPY handler.py /workspace/handler.py
COPY video_720p.py /workspace/video_720p.py
COPY eros_ref2va.py /workspace/eros_ref2va.py
COPY lora_url_policy.py /workspace/lora_url_policy.py
COPY h3_extender_poc.py /workspace/h3_extender_poc.py
COPY extender_r2_io.py /workspace/extender_r2_io.py
RUN python -m py_compile /workspace/handler.py /workspace/video_720p.py /workspace/eros_ref2va.py /workspace/download_models.py
COPY registered_lora.py /workspace/registered_lora.py

CMD ["python", "/workspace/handler.py"]
